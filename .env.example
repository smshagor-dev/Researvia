# Application
NODE_ENV=development
APP_URL=http://localhost:3000

# MongoDB (Atlas or self-hosted)
MONGODB_URI=mongodb://127.0.0.1:27017/researvia

# Authentication secrets - use strong random values in production
SESSION_SECRET=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# SMTP - required for registration verification and password reset flows
# Any standards-compliant SMTP service can be used; no paid provider is required.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ResearVia <no-reply@example.com>

# OAuth (future/optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional AI provider. Core platform must work without this.
AI_PROVIDER=disabled
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
