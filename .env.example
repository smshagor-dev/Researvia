# Application
NODE_ENV=development
APP_URL=http://localhost:3000

# MongoDB (Atlas or self-hosted)
MONGODB_URI=mongodb://127.0.0.1:27017/researvia

# Authentication / encryption secrets - use strong random values in production
SESSION_SECRET=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
WORKER_SECRET=replace-with-at-least-32-random-characters

# Web Push / PWA notifications
# Generate a VAPID key pair with: npx web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:notifications@example.com

# SMTP - required for registration verification/password reset and system mailbox outbound delivery.
# For system mail, use an SMTP provider authorized to send for SYSTEM_MAIL_DOMAIN (SPF + DKIM configured).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ResearVia <no-reply@example.com>

# ResearVia system mailbox
# Each verified user receives an immutable address such as shagor4821@researvia.com.
# Configure the domain MX for Mailgun receiving and verify the same domain for SMTP sending.
SYSTEM_MAIL_DOMAIN=researvia.com
SYSTEM_MAIL_FROM_NAME=ResearVia Mail
SYSTEM_MAIL_MAX_ATTACHMENT_MB=15
# Mailgun account HTTP webhook signing key (not the private API key).
MAILGUN_WEBHOOK_SIGNING_KEY=
# Mailgun receiving route example:
#   match_recipient(".*@researvia.com")
#   forward("https://YOUR_APP/api/v1/webhooks/mailgun/inbound")
#   stop()

# Gmail / Microsoft mailbox OAuth (optional; required only to connect those providers)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Professor contact enrichment (optional, free ORCID Public API credentials)
# ROR and OpenAlex enrichment use their public APIs without a secret.
# Register an ORCID Public API client and use /read-public credentials to read public email/profile/employment metadata.
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_API_BASE=https://pub.orcid.org/v3.0
ORCID_TOKEN_URL=https://orcid.org/oauth/token

# Optional OpenAI-compatible AI endpoint. Deterministic tools remain available when disabled.
AI_PROVIDER=disabled
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
