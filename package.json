{
  "name": "researvia",
  "version": "0.1.0",
  "private": true,
  "description": "Free academic opportunity and research discovery platform for students.",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "node worker/index.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
